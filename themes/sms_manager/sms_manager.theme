<?php

/**
 * @file
 * SMS Manager theme: Drupal shell for the Vue application.
 */

use Drupal\Core\Url;

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function sms_manager_preprocess_page(&$variables) {
  $merge = \Drupal::service('router.route_provider')->getRoutesByNames(['sms_merge.form']);
  $variables['#attached']['drupalSettings']['smsManager'] = [
    'siteName' => \Drupal::config('system.site')->get('name'),
    'mergeUrl' => $merge ? Url::fromRoute('sms_merge.form')->toString() : NULL,
  ];
  $variables['#cache']['contexts'][] = 'user.permissions';
}

/**
 * Implements hook_page_attachments_alter().
 *
 * App-like mobile screen: no pinch / double-tap zoom.
 */
function sms_manager_page_attachments_alter(array &$attachments) {
  foreach ($attachments['#attached']['html_head'] ?? [] as $i => $item) {
    if (($item[1] ?? '') === 'viewport') {
      $attachments['#attached']['html_head'][$i][0]['#attributes']['content'] =
        'width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover';
    }
  }
}
